{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":configMigration",
    "security:minimumReleaseAgeNpm"
  ],
  "enabledManagers": ["composer", "npm", "github-actions", "custom.regex"],
  "timezone": "America/Toronto",
  "schedule": ["before 6am on Monday"],
  "labels": ["dependencies"],
  "dependencyDashboard": true,
  "automerge": true,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "platformAutomerge": true,
  "rebaseWhen": "behind-base-branch",
  "vulnerabilityAlerts": {
    "enabled": true,
    "automerge": true,
    "addLabels": ["security"],
    "vulnerabilityFixStrategy": "lowest"
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on Monday"],
    "automerge": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)\\.wp-env\\.(?:legacy|current)\\.json$/"
      ],
      "matchStrings": [
        "\"core\"\\s*:\\s*\"WordPress/WordPress#(?<currentValue>\\d+\\.\\d+(?:\\.\\d+)?)\""
      ],
      "depNameTemplate": "WordPress",
      "packageNameTemplate": "WordPress/WordPress",
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver-coerced"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)\\.wp-env\\.(?:legacy|current)\\.json$/"
      ],
      "matchStrings": [
        "https://downloads\\.wordpress\\.org/plugin/woocommerce\\.(?<currentValue>\\d+\\.\\d+\\.\\d+)\\.zip"
      ],
      "depNameTemplate": "WooCommerce",
      "packageNameTemplate": "woocommerce/woocommerce",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver-coerced"
    }
  ],
  "packageRules": [
    {
      "description": "Update lock files while preserving compatible manifest ranges",
      "matchManagers": ["composer", "npm"],
      "rangeStrategy": "update-lockfile"
    },
    {
      "description": "Group non-major Composer updates",
      "matchManagers": ["composer"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Composer non-major dependencies",
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Group non-major npm updates",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "npm non-major dependencies"
    },
    {
      "description": "Group GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "pinDigest", "digest"],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Major updates queue on the dependency dashboard instead of opening a pull request that nothing can merge",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true,
      "automerge": false,
      "addLabels": ["breaking"]
    },
    {
      "description": "npm overrides are security pins on transitive packages, so they follow the advisory that created them and never a major release",
      "matchManagers": ["npm"],
      "matchDepTypes": ["overrides"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "PHP 8.1 is the supported baseline and PHPUnit 11 requires PHP 8.2, so PHPUnit 10 is the ceiling until that baseline moves",
      "matchPackageNames": ["phpunit/phpunit"],
      "allowedVersions": "<11"
    },
    {
      "description": "The polyfills follow PHPUnit: 3.0 and later drop the PHPUnit 10 support this repository still needs",
      "matchPackageNames": ["yoast/phpunit-polyfills"],
      "allowedVersions": "<3"
    },
    {
      "description": "PHP_CodeSniffer 4 waits for WPCS, VIPCS and PHPCompatibility, wordpress-stubs 7 waits for phpstan-wordpress and psalm-plugin-wordpress. Approve them on the dashboard once those releases land",
      "matchPackageNames": [
        "squizlabs/php_codesniffer",
        "php-stubs/wordpress-stubs"
      ],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Keep legacy WordPress on the 6.8 release line",
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["dianxiaomi/.wp-env.legacy.json"],
      "matchPackageNames": ["WordPress/WordPress"],
      "allowedVersions": "/^6\\.8(?:\\.\\d+)?$/"
    },
    {
      "description": "Keep legacy WooCommerce below 10.8",
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["dianxiaomi/.wp-env.legacy.json"],
      "matchPackageNames": ["woocommerce/woocommerce"],
      "allowedVersions": "<10.8.0"
    },
    {
      "description": "Keep current WordPress on the 7.0 release line",
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["dianxiaomi/.wp-env.current.json"],
      "matchPackageNames": ["WordPress/WordPress"],
      "allowedVersions": "/^7\\.0(?:\\.\\d+)?$/"
    },
    {
      "description": "Group legacy compatibility stack updates",
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["dianxiaomi/.wp-env.legacy.json"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Legacy WordPress compatibility stack",
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Group current compatibility stack updates",
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["dianxiaomi/.wp-env.current.json"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Current WordPress compatibility stack",
      "minimumReleaseAge": "3 days"
    }
  ]
}
