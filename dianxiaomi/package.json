{
  "name": "dianxiaomi",
  "version": "1.6.1",
  "description": "WooCommerce tracking number plugin",
  "scripts": {
    "wp-env": "wp-env",
    "test": "wp-env run cli --config=.wp-env.current.json --env-cwd=wp-content/plugins/dianxiaomi vendor/bin/phpunit",
    "test:legacy": "wp-env run cli --config=.wp-env.legacy.json --env-cwd=wp-content/plugins/dianxiaomi vendor/bin/phpunit",
    "test:watch": "wp-env run cli --config=.wp-env.current.json --env-cwd=wp-content/plugins/dianxiaomi vendor/bin/phpunit --filter",
    "start": "wp-env start --config=.wp-env.current.json",
    "start:legacy": "wp-env start --config=.wp-env.legacy.json",
    "stop": "wp-env stop --config=.wp-env.current.json",
    "stop:legacy": "wp-env stop --config=.wp-env.legacy.json",
    "destroy": "wp-env destroy --config=.wp-env.current.json",
    "destroy:legacy": "wp-env destroy --config=.wp-env.legacy.json",
    "check:compatibility": "node ../scripts/check-compatibility.mjs"
  },
  "devDependencies": {
    "@wordpress/env": "^12.1.0"
  },
  "engines": {
    "node": ">=24.18.0",
    "npm": ">=11.16.0"
  },
  "overrides": {
    "@wordpress/env": {
      "rimraf": "^6.1.4"
    },
    "express": {
      "qs": "^6.16.1"
    }
  }
}
